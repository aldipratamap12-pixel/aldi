---
interface Props { variant?: 'outline' | 'accent' | 'inverse' | 'dev'; }
const { variant = 'outline' } = Astro.props;
---
<span class:list={['tag', `tag--${variant}`]}><slot /></span>

<style>
  .tag {
    display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: var(--radius-full);
    font-family: var(--font-mono); font-weight: 500; font-size: 11px; line-height: 1.4; letter-spacing: 0.08em; text-transform: uppercase;
    white-space: nowrap;
  }
  .tag--outline { border: 1px solid var(--color-border-default); color: var(--color-text-primary); }
  .tag--accent { background: var(--color-accent-subtle); color: var(--color-text-accent); }
  .tag--inverse { background: var(--color-bg-inverse); color: var(--color-text-inverse); }
  /* dev-only review marker: never rendered in a production build */
  .tag--dev { border: 1px dashed var(--color-text-secondary); background: var(--color-bg-surface); color: var(--color-text-primary); }
  .tag--dev::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: #D98C1A; }
</style>
