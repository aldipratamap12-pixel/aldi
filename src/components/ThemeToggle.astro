---
// Light/dark toggle. The icon is a small horizon: in light mode the sun is up and the moon is below the horizon;
// switching sets the sun and raises the moon (and back). The page switch uses the View Transitions API:
// the new theme rises from the bottom of the screen like a sunrise (light) or moonrise (dark).
// Falls back to a color fade, and to an instant switch when the visitor prefers reduced motion.
---
<button class="tt" type="button" data-theme-toggle aria-label="Switch to dark theme" aria-pressed="false">
  <svg class="tt-svg" viewBox="0 0 32 32" width="22" height="22" aria-hidden="true">
    <defs><clipPath id="tt-sky"><rect x="0" y="0" width="32" height="24" /></clipPath></defs>
    <g clip-path="url(#tt-sky)">
      <g class="tt-sun">
        <circle cx="16" cy="16" r="5" fill="currentColor" />
        <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M16 6.5v2M16 23.5v2M6.5 16h2M23.5 16h2M9.3 9.3l1.4 1.4M21.3 21.3l1.4 1.4M9.3 22.7l1.4-1.4M21.3 10.7l1.4-1.4" />
        </g>
      </g>
      <g class="tt-moon">
        <path d="M20.5 9.5a7 7 0 1 0 2 11.8 5.6 5.6 0 0 1-2-11.8z" fill="currentColor" />
        <circle class="tt-star" cx="9" cy="8" r="1" fill="currentColor" />
        <circle class="tt-star" cx="25" cy="6" r="0.8" fill="currentColor" />
      </g>
    </g>
    <path d="M5 25h22" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  </svg>
</button>

<script>
  const KEY = 'theme';
  const root = document.documentElement;
  const meta = document.querySelector('meta[name="theme-color"]');
  const reduce = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const current = () => (root.dataset.theme === 'dark' ? 'dark' : 'light');

  const sync = () => {
    const dark = current() === 'dark';
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
      b.setAttribute('aria-pressed', String(dark));
      b.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
    });
    if (meta) meta.setAttribute('content', dark ? '#11100E' : '#F5F3EE');
  };

  const apply = (t: string) => {
    root.dataset.theme = t;
    try { localStorage.setItem(KEY, t); } catch {}
    sync();
  };

  const toggle = () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    const doc = document as Document & { startViewTransition?: (cb: () => void) => { ready: Promise<void> } };
    if (reduce()) { apply(next); return; }
    if (!doc.startViewTransition) {
      root.classList.add('theme-fade');
      apply(next);
      window.setTimeout(() => root.classList.remove('theme-fade'), 700);
      return;
    }
    root.classList.add('theme-switching');
    const vt = doc.startViewTransition(() => apply(next));
    vt.ready.then(() => {
      // A circle rising from below the bottom edge, like the sun (or moon) coming over the horizon.
      const w = window.innerWidth, h = window.innerHeight;
      const r = Math.hypot(w / 2, h) * 1.15;
      root.animate(
        { clipPath: [`circle(${r * 0.08}px at 50% ${h + r * 0.08}px)`, `circle(${r}px at 50% ${h + r * 0.15}px)`] },
        { duration: 1100, easing: 'cubic-bezier(.65,0,.25,1)', pseudoElement: '::view-transition-new(root)' },
      );
    }).catch(() => {});
    window.setTimeout(() => root.classList.remove('theme-switching'), 1300);
  };

  sync();
  document.querySelectorAll('[data-theme-toggle]').forEach((b) => b.addEventListener('click', toggle));
  // Follow the system setting until the visitor picks a theme.
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    let saved = null; try { saved = localStorage.getItem(KEY); } catch {}
    if (!saved) { root.dataset.theme = e.matches ? 'dark' : 'light'; sync(); }
  });
</script>

<style>
  .tt {
    display: inline-flex; align-items: center; justify-content: center; flex: none;
    width: 44px; height: 44px; border-radius: 50%; cursor: pointer;
    border: 1px solid var(--color-border-default); background: var(--color-bg-surface); color: var(--color-text-primary);
    transition: background-color 200ms var(--ease-out), border-color 200ms var(--ease-out), transform 120ms var(--ease-out);
  }
  .tt:hover { border-color: var(--color-text-primary); }
  .tt:active { transform: scale(0.94); }
  .tt-svg { overflow: visible; }
  .tt-sun, .tt-moon { transform-box: view-box; transform-origin: 16px 25px; transition: transform 900ms cubic-bezier(.65,0,.25,1), opacity 600ms ease; }
  .tt-star { opacity: 0; transition: opacity 400ms ease 500ms; }

  /* light: sun up, moon below the horizon */
  .tt-sun { transform: rotate(0deg) translateY(0); }
  .tt-moon { transform: rotate(60deg) translateY(16px); opacity: 0; }
  /* dark: sun sets to the right, moon rises from the left */
  :global([data-theme="dark"]) .tt-sun { transform: rotate(-60deg) translateY(16px); opacity: 0; }
  :global([data-theme="dark"]) .tt-moon { transform: rotate(0deg) translateY(0); opacity: 1; }
  :global([data-theme="dark"]) .tt-star { opacity: 1; }
  .tt:hover .tt-sun { transform: rotate(20deg); }
  :global([data-theme="dark"]) .tt:hover .tt-sun { transform: rotate(-60deg) translateY(16px); }
  :global([data-theme="dark"]) .tt:hover .tt-moon { transform: rotate(-12deg); }
</style>
