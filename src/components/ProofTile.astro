---
interface Props { index: number; title: string; body: string; tone?: 'light' | 'dark'; }
const { index, title, body, tone = 'light' } = Astro.props;
---
<li class:list={['tile', `tile--${tone}`]} data-reveal>
  <span class="t-label-s idx">{String(index).padStart(2, '0')}</span>
  <div class="txt">
    <h3 class="t-h4">{title}</h3>
    <p class="t-body-s">{body}</p>
  </div>
</li>

<style>
  .tile { display: flex; flex-direction: column; gap: 40px; padding: 24px 24px 28px; border-radius: var(--radius-lg);
    transition: transform 300ms var(--ease-out), border-color 300ms var(--ease-out); }
  .tile:hover { transform: translateY(-4px); }
  .txt { display: grid; gap: 8px; }
  .tile--light { background: var(--color-bg-surface); border: 1px solid var(--color-border-default); }
  .tile--light .idx { color: var(--color-text-accent); }
  .tile--light p { color: var(--color-text-secondary); }
  .tile--dark { background: var(--color-bg-inverse); border: 1px solid var(--color-border-inverse); color: var(--color-text-inverse); }
  .tile--dark .idx { color: var(--color-text-accent-on-dark); }
  .tile--dark p { color: var(--color-text-inverse-muted); }
  .tile--dark:hover { border-color: var(--color-accent-on-dark); }
</style>
