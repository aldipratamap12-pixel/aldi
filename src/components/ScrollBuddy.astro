---
// A small cursor character that stands on the top edge of page components and jumps
// to the next one as you scroll: it runs to the corner, jumps, lands, then trots to its spot.
// Mark a component with data-perch (optional data-perch-x="0.8" = where on its top edge it stands).
// Decoration only: aria-hidden, no pointer events. Desktop with a mouse only; off with reduced motion or ?nomotion.
---
<div class="sb" aria-hidden="true" data-buddy hidden>
  <svg viewBox="0 0 48 44" class="sb-body">
    <g class="sb-face">
      <g class="sb-leg" style="transform-origin: 17px 30px"><path d="M17 30 L15 41" stroke="#3D55FF" stroke-width="2.4" stroke-linecap="round" /><ellipse cx="14" cy="42" rx="3.2" ry="1.6" fill="#3D55FF" /></g>
      <g class="sb-leg" style="transform-origin: 22px 28px"><path d="M22 28 L25 41" stroke="#3D55FF" stroke-width="2.4" stroke-linecap="round" /><ellipse cx="26" cy="42" rx="3.2" ry="1.6" fill="#3D55FF" /></g>
      <path d="M14 2 L14 31 L20 25.5 L24 34 L28.5 32 L24.5 23.5 L33 23.5 Z" fill="#fff" stroke="#16161a" stroke-width="2" stroke-linejoin="round" />
      <g class="sb-eye">
        <circle cx="16.5" cy="13" r="4.6" fill="#fff" stroke="#16161a" stroke-width="1.5" />
        <g class="sb-pupil"><circle cx="16.5" cy="13" r="2.3" fill="#16161a" /><circle cx="17.3" cy="12.1" r="0.8" fill="#fff" /></g>
      </g>
      <g class="sb-eye">
        <circle cx="25.5" cy="15.5" r="4.6" fill="#fff" stroke="#16161a" stroke-width="1.5" />
        <g class="sb-pupil"><circle cx="25.5" cy="15.5" r="2.3" fill="#16161a" /><circle cx="26.3" cy="14.6" r="0.8" fill="#fff" /></g>
      </g>
    </g>
  </svg>
</div>

<script>
  const el = document.querySelector<HTMLElement>('[data-buddy]');
  const ok = window.matchMedia('(min-width: 1024px) and (hover: hover) and (pointer: fine)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (el && ok.matches && !reduce && document.documentElement.classList.contains('motion')) start(el);

  function start(el: HTMLElement) {
    const body = el.querySelector<SVGElement>('.sb-body')!;
    const face = el.querySelector<SVGGElement>('.sb-face')!;
    const eyes = [...el.querySelectorAll<SVGGElement>('.sb-eye')];
    const pupils = [...el.querySelectorAll<SVGGElement>('.sb-pupil')];
    const legs = [...el.querySelectorAll<SVGGElement>('.sb-leg')];
    const W = 48, H = 44, G = 2900; // size in px; gravity in px/s²
    const EDGE = 8; // how close to a corner the feet go before take-off

    const perches = [...document.querySelectorAll<HTMLElement>('[data-perch]')];
    if (!perches.length) return;
    const rest = (p: HTMLElement) => parseFloat(p.dataset.perchX ?? (p.closest('.col--offset') ? '0.18' : '0.82'));
    const rect = (p: HTMLElement) => p.getBoundingClientRect();
    // Feet position on a perch at a fraction f of its width, in viewport px. Read live every frame,
    // so parallax and smooth scroll are followed.
    const at = (p: HTMLElement, f: number) => { const r = rect(p); return { x: r.left + r.width * f - W / 2, y: r.top - H + 2 }; };
    const toF = (p: HTMLElement, x: number) => { const r = rect(p); return (x + W / 2 - r.left) / r.width; };
    const clampF = (p: HTMLElement, f: number, inset: number) => { const w = rect(p).width; return Math.min(Math.max(f, inset / w), 1 - inset / w); };

    type Run = { p: HTMLElement; f0: number; f1: number; start: number; dur: number };
    type Jump = { from: HTMLElement; to: HTMLElement; ff: number; ft: number; a0: { x: number; y: number }; b0: { x: number; y: number }; t1: number; t2: number; v0: number; start: number; up: boolean };
    let cur: HTMLElement | null = null, f = 0.5;               // where it stands now
    let phase: 'idle' | 'run1' | 'pre' | 'air' | 'land' | 'run2' = 'idle';
    let run: Run | null = null, jump: Jump | null = null, next: HTMLElement | null = null;
    let t0 = 0, dir = 1, stride = 0, mx = -1, my = -1;

    const band = () => ({ top: Math.max(120, innerHeight * 0.2), bottom: innerHeight * 0.86 });
    const live = (p: HTMLElement) => { const r = rect(p), b = band(); return r.width > 0 && r.top > b.top + 24 && r.top < b.bottom - 24; };
    function pick(): HTMLElement | null {
      const list = perches.filter(live).sort((a, b) => rect(a).top - rect(b).top);
      if (!cur) return list[0] ?? null;
      const t = rect(cur).top, b = band();
      if (t < b.top) return list.find((p) => rect(p).top > t) ?? null;               // scrolled down: the next one below
      if (t > b.bottom) return [...list].reverse().find((p) => rect(p).top < t) ?? null; // scrolled up: the one above
      return null;
    }
    const runFor = (p: HTMLElement, f0: number, f1: number, now: number): Run => {
      const dist = Math.abs(f1 - f0) * rect(p).width;
      return { p, f0, f1, start: now, dur: Math.min(Math.max(dist / 650, 0.16), 0.6) * 1000 };
    };

    // 1. Run to the corner of the current component that faces the next one.
    function leave(to: HTMLElement, now: number) {
      next = to;
      const here = at(cur!, f), there = at(to, rest(to)), r = rect(cur!);
      dir = there.x + W / 2 >= here.x + W / 2 - 40 ? 1 : -1;
      const onScreen = r.top > -H && r.top < innerHeight + H;
      const edge = dir > 0 ? 1 - EDGE / r.width : EDGE / r.width;
      if (onScreen) { run = runFor(cur!, f, edge, now); phase = 'run1'; }
      else { f = edge; takeOff(now); } // its component already left the screen: no time to run
      look(1.5, 0);
      body.classList.remove('idle');
    }
    // 2. Jump off the corner and land a little ahead, inside the next component.
    function takeOff(now: number) {
      const to = next!, a = at(cur!, f);
      a.y = Math.min(Math.max(a.y, -H), innerHeight);
      const ft = clampF(to, toF(to, a.x + dir * 56), 26);
      const b = at(to, ft), up = b.y < a.y;
      const apex = up ? b.y - 16 : a.y - 22, h1 = a.y - apex, h2 = b.y - apex;
      jump = { from: cur!, to, ff: f, ft, a0: a, b0: b, t1: Math.sqrt((2 * h1) / G), t2: Math.sqrt((2 * h2) / G), v0: -Math.sqrt(2 * G * h1), start: now, up };
      phase = 'pre'; t0 = now;
      look(1.4, up ? -1.6 : 1.6);
    }

    function look(x: number, y: number) { pupils.forEach((p) => (p.style.transform = `translate(${x}px, ${y}px)`)); }
    function blink(d = 150) {
      eyes.forEach((e) => e.animate([{ transform: 'scaleY(1)' }, { transform: 'scaleY(.08)', offset: 0.45 }, { transform: 'scaleY(.08)', offset: 0.55 }, { transform: 'scaleY(1)' }], { duration: d, easing: 'ease-in-out' }));
    }
    (function blinkLoop() { if (phase === 'idle') { blink(); if (Math.random() < 0.3) setTimeout(() => blink(), 230); } setTimeout(blinkLoop, 2200 + Math.random() * 2800); })();
    addEventListener('pointermove', (e) => { mx = e.clientX; my = e.clientY; }, { passive: true });
    const legPose = (a: number, b: number) => { legs[0].style.transform = `rotate(${a}deg)`; legs[1].style.transform = `rotate(${b}deg)`; };

    const PRE = 90, LAND = 300;
    function frame(now: number) {
      let x = 0, y = 0, sx = 1, sy = 1, r = 0, bob = 0;
      if (!cur) { cur = pick(); if (cur) { f = rest(cur); el.hidden = false; body.classList.add('idle'); } }
      if (cur && phase === 'idle') { const n = pick(); if (n && n !== cur) leave(n, now); }

      if (phase === 'run1' || phase === 'run2') {
        const k = Math.min((now - run!.start) / run!.dur, 1);
        const e = phase === 'run1' ? k * k * (2 - k) * 0.4 + k * 0.6 : 1 - Math.pow(1 - k, 2); // speed up into the jump, ease out at the end
        f = run!.f0 + (run!.f1 - run!.f0) * e;
        const p = at(run!.p, f); x = p.x; y = p.y;
        stride = Math.abs(f - run!.f0) * rect(run!.p).width / 7;
        const s = Math.sin(stride); legPose(30 * s, -30 * s); bob = -Math.abs(s) * 2.4; r = 5 * dir;
        if (k >= 1) {
          if (phase === 'run1') takeOff(now);
          else { phase = 'idle'; run = null; legPose(0, 0); r = 0; bob = 0; body.classList.add('idle'); }
        }
      }
      if (phase === 'pre') {
        const k = Math.sin((Math.PI / 2) * Math.min((now - t0) / PRE, 1)), p = at(jump!.from, jump!.ff);
        x = p.x; y = Math.min(Math.max(p.y, -H), innerHeight); sx = 1 + 0.1 * k; sy = 1 - 0.14 * k; legPose(-12 * k, 12 * k);
        if (now - t0 >= PRE) { phase = 'air'; t0 = now; }
      } else if (phase === 'air') {
        const j = jump!, t = (now - t0) / 1000, T = j.t1 + j.t2, u = Math.min(t / T, 1);
        const a = at(j.from, j.ff), b = at(j.to, j.ft);
        a.y = Math.min(Math.max(a.y, -H), innerHeight);
        // Ballistic arc measured against the take-off line, laid over the live start and end points.
        const tt = Math.min(t, T), phys = j.v0 * tt + 0.5 * G * tt * tt, line = (j.b0.y - j.a0.y) * u;
        x = a.x + (b.x - a.x) * u; y = a.y + (b.y - a.y) * u + (phys - line);
        const vy = j.v0 + G * tt, s = Math.min(0.14, Math.abs(vy) / 8000);
        sy = 1 + s; sx = 1 - s * 0.55; r = dir * Math.max(-9, Math.min(9, vy / 120)) * 0.5 * (j.up ? -1 : 1);
        legPose(vy < 0 ? -22 : 14, vy < 0 ? 26 : -10); // tucked going up, reaching down to land
        if (u >= 1) { phase = 'land'; t0 = now; cur = j.to; f = j.ft; blink(170); legPose(0, 0); }
      } else if (phase === 'land') {
        const k = Math.min((now - t0) / LAND, 1), d = Math.exp(-5 * k) * Math.cos(k * Math.PI * 3), p = at(cur!, f);
        x = p.x; y = p.y; sy = 1 - 0.2 * d; sx = 1 + 0.14 * d;
        if (k >= 1) {
          // 3. Trot from the landing spot to its usual place on this component.
          const goal = rest(cur!); jump = null;
          if (Math.abs(goal - f) * rect(cur!).width > 6) { dir = goal > f ? 1 : -1; run = runFor(cur!, f, goal, now); phase = 'run2'; look(1.5, 0); }
          else { phase = 'idle'; body.classList.add('idle'); }
        }
      } else if (phase === 'idle' && cur) {
        const p = at(cur, f); x = p.x; y = p.y;
        if (mx >= 0) { const dx = mx - (x + W / 2), dy = my - (y + 14), d = Math.hypot(dx, dy) || 1; look((dx / d) * 1.5 * dir, (dy / d) * 1.5); }
      }

      if (cur) {
        el.style.transform = `translate3d(${x.toFixed(1)}px, ${(y + bob).toFixed(1)}px, 0)`;
        body.style.transform = `rotate(${r.toFixed(2)}deg) scale(${sx.toFixed(3)}, ${sy.toFixed(3)})`;
        face.style.transform = `scaleX(${dir})`;
      }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
    ok.addEventListener('change', (e) => { if (!e.matches) el.hidden = true; });
  }
</script>

<style>
  .sb { position: fixed; left: 0; top: 0; z-index: 40; width: 48px; height: 44px; pointer-events: none; will-change: transform; }
  .sb[hidden] { display: none; }
  .sb-body { display: block; width: 100%; height: 100%; overflow: visible; transform-origin: 50% 100%; will-change: transform; }
  .sb-face { transform-origin: 24px 44px; transition: transform 0.18s ease; }
  .sb-eye { transform-box: fill-box; transform-origin: center; }
  .sb-pupil { transition: transform 0.22s cubic-bezier(0.3, 0.7, 0.3, 1); }
  .sb-body.idle { animation: sb-idle 2.4s ease-in-out infinite; }
  @keyframes sb-idle { 0%, 100% { transform: scale(1, 1); } 50% { transform: scale(1.02, 0.97); } }
</style>
