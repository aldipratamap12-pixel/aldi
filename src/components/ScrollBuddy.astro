---
// A small cursor character that hops down the page step by step: in every section it goes like stairs
// from the right side to the left side, over headings, text, images and cards. It follows the scroll.
// Extra perches: data-perch. Areas to avoid: data-perch-skip.
// Decoration only: aria-hidden, no pointer events. Desktop with a mouse only; off with reduced motion or ?nomotion.
---
<div class="sb" aria-hidden="true" data-buddy hidden>
  <svg viewBox="0 0 48 44" class="sb-body">
    <g class="sb-face">
      <g class="sb-leg" style="transform-origin: 17px 30px"><path d="M17 30 L15 41" stroke="#3D55FF" stroke-width="2.4" stroke-linecap="round" /><ellipse cx="14" cy="42" rx="3.2" ry="1.6" fill="#3D55FF" /></g>
      <g class="sb-leg" style="transform-origin: 22px 28px"><path d="M22 28 L25 41" stroke="#3D55FF" stroke-width="2.4" stroke-linecap="round" /><ellipse cx="26" cy="42" rx="3.2" ry="1.6" fill="#3D55FF" /></g>
      <path d="M14 2 L14 31 L20 25.5 L24 34 L28.5 32 L24.5 23.5 L33 23.5 Z" fill="#fff" stroke="#16161a" stroke-width="2" stroke-linejoin="round" />
      <g class="sb-eye">
        <circle cx="16.5" cy="13" r="4.6" fill="#fff" stroke="#16161a" stroke-width="1.5" />
        <g class="sb-pupil"><circle cx="16.5" cy="13" r="2.3" fill="#16161a" /><circle cx="17.3" cy="12.1" r="0.8" fill="#fff" /></g>
      </g>
      <g class="sb-eye">
        <circle cx="25.5" cy="15.5" r="4.6" fill="#fff" stroke="#16161a" stroke-width="1.5" />
        <g class="sb-pupil"><circle cx="25.5" cy="15.5" r="2.3" fill="#16161a" /><circle cx="26.3" cy="14.6" r="0.8" fill="#fff" /></g>
      </g>
    </g>
  </svg>
</div>

<script>
  const el = document.querySelector<HTMLElement>('[data-buddy]');
  const ok = window.matchMedia('(min-width: 1024px) and (hover: hover) and (pointer: fine)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (el && ok.matches && !reduce && document.documentElement.classList.contains('motion')) start(el);

  function start(el: HTMLElement) {
    const body = el.querySelector<SVGElement>('.sb-body')!;
    const face = el.querySelector<SVGGElement>('.sb-face')!;
    const eyes = [...el.querySelectorAll<SVGGElement>('.sb-eye')];
    const pupils = [...el.querySelectorAll<SVGGElement>('.sb-pupil')];
    const legs = [...el.querySelectorAll<SVGGElement>('.sb-leg')];
    const W = 48, H = 44, G = 3000; // size in px; gravity in px/s²
    const INSET = 14;              // keep the feet this far inside an edge

    // Anything with a visible top edge can be stood on: headings, text, images, tiles, plus [data-perch].
    // Only the first line of a split heading: the lines below sit too close to stand between.
    const SEL = 'h2 .line-mask:first-child, h2:not([data-split]), h3, p, img, dd, .f-name, .tiles > li, .hv-kpi .card, .hv-perch, [data-perch]';
    const HV = '.hv-kpi .card, .hv-perch'; // the hero visual is skipped, except its cards
    const SKIP = '[data-perch-skip], .hv, nav, footer, .visually-hidden, [data-buddy], .tags, .ctas';
    const isBlock = (e: Element) => e.matches('img, li, rect, .btn, [data-perch]');
    // First spot on page load: the hero's "Contact me" button.
    const START = document.querySelector('[data-hero] .ctas .btn:last-child');
    // Live geometry in viewport px. For text: the first line only, so it stands on the words, not the empty box.
    function geo(e: P) {
      if (!(e instanceof Element)) { const q = e.host.getBoundingClientRect(); return { l: q.left + q.width * e.a[0], r: q.left + q.width * e.a[1], t: q.top + q.height * e.a[2], w: q.width * (e.a[1] - e.a[0]) }; }
      let r: DOMRect | undefined;
      if (!isBlock(e)) { const rg = document.createRange(); rg.selectNodeContents(e); r = [...rg.getClientRects()].find((q) => q.width > 4); }
      r = r ?? e.getBoundingClientRect();
      return { l: r.left, r: r.right, t: r.top, w: r.width };
    }
    const shown = (p: P) => { const e = p instanceof Element ? p : p.host; const rv = e.closest('[data-reveal]'); return !rv || +getComputedStyle(rv).opacity > 0.6; };

    // A spot inside a picture: [left, right, top] as fractions of the image, for images whose top edge is empty space.
    type P = Element | { host: Element; a: number[] };
    let perches: P[] = [];
    function collect() {
      const all = [...document.querySelectorAll(SEL)].filter((e) => (!e.closest(SKIP) || e.matches(HV)) && (e.textContent?.trim() || isBlock(e)));
      const g = all.map((e) => ({ e, ...geo(e) })).filter((q) => q.w > 40);
      // Drop near-duplicates (same top edge over the same span): keep the wider one.
      const areas = [...document.querySelectorAll<HTMLElement>('[data-perch-areas]')].flatMap((h) => h.dataset.perchAreas!.split(';').map((s) => ({ host: h.querySelector('img') ?? h, a: s.trim().split(/\s+/).map(Number) })));
      perches = [...(START ? [START] : []), ...areas, ...g.filter((a) => !g.some((b) => b !== a && Math.abs(b.t - a.t) < 10 && b.l < a.r && a.l < b.r && (b.w > a.w || (b.w === a.w && g.indexOf(b) < g.indexOf(a))))).map((q) => q.e)];
    }
    const refresh = () => { const keep = idx >= 0 ? path[idx]?.p : null; collect(); buildPath(); if (keep) { const i = path.findIndex((s) => s.p === keep); if (i >= 0 && phase === 'idle') idx = i; } };
    // collect() runs first, then the route is built once the helpers below exist.
    queueMicrotask(refresh);
    setTimeout(refresh, 1500);
    addEventListener('resize', refresh);

    const foot = (e: P, f: number) => { const g = geo(e); return { x: g.l + g.w * f, y: g.t + 2 }; };

    // The route: section by section, each one walked like stairs from its right side down to its left side.
    // Every step is the closest spot below the last one, near a line that runs from top-right to bottom-left.
    type Step = { p: P; f: number };
    let path: Step[] = [];
    const MIN_DY = 56;
    const hostOf = (p: P) => (p instanceof Element ? p : p.host);
    function buildPath() {
      const nodes = perches.map((p) => { const g = geo(p); return { p, l: g.l, r: g.r, t: g.t + scrollY, sec: hostOf(p).closest('section') }; })
        .filter((n) => n.r - n.l > 2 * INSET && n.sec);
      const secs = [...new Set(nodes.map((n) => n.sec))].sort((a, b) => a!.getBoundingClientRect().top - b!.getBoundingClientRect().top);
      const out: Step[] = [];
      for (const sec of secs) {
        let mine = nodes.filter((n) => n.sec === sec);
        const startNode = START ? mine.find((n) => n.p === START) : undefined;
        if (startNode) mine = mine.filter((n) => n.t >= startNode.t); // the hero starts at Contact me
        if (!mine.length) continue;
        const L = Math.min(...mine.map((n) => n.l)) + INSET, R = Math.max(...mine.map((n) => n.r)) - INSET;
        const T = Math.min(...mine.map((n) => n.t)), B = Math.max(...mine.map((n) => n.t));
        const lineX = (t: number) => R - ((t - T) / (B - T || 1)) * (R - L);
        const at = (n: typeof mine[0]) => Math.min(Math.max(lineX(n.t), n.l + INSET), n.r - INSET);
        let last = startNode ?? null, lastT = startNode ? startNode.t : T - MIN_DY;
        if (startNode) out.push({ p: startNode.p, f: 0.5 });
        for (;;) {
          let best: typeof mine[0] | null = null, bc = Infinity;
          for (const n of mine) {
            if (n === last || n.t < lastT + MIN_DY) continue;
            const c = (n.t - lastT) + 1.5 * Math.abs(at(n) - lineX(n.t));
            if (c < bc) { bc = c; best = n; }
          }
          if (!best) break;
          out.push({ p: best.p, f: (at(best) - best.l) / (best.r - best.l) });
          last = best; lastT = best.t;
        }
      }
      path = out;
    }

    let idx = -1, dir = -1;
    let phase: 'idle' | 'pre' | 'air' | 'land' = 'idle';
    let jump: { to: number; a0: { x: number; y: number }; b0: { x: number; y: number }; T: number; v0: number; up: boolean } | null = null;
    let t0 = 0, mx = -1, my = -1;
    const y0 = scrollY; // stay on the start button until the visitor scrolls
    const stepAt = (i: number) => foot(path[i].p, path[i].f);
    const topOf = (i: number) => geo(path[i].p).t;

    // Which step it should be on: the one nearest the middle of the screen.
    function wanted(): number {
      const L = innerHeight * 0.5;
      let best = -1, bd = Infinity;
      path.forEach((s, i) => { const t = topOf(i); const d = Math.abs(t - L); if (t > 70 && t < innerHeight - 50 && d < bd && shown(s.p)) { bd = d; best = i; } });
      return best;
    }
    // One step toward it at a time. Steps already off the screen are skipped.
    function nextStep(): number {
      const w = wanted();
      if (w < 0 || w === idx) return -1;
      const L = innerHeight * 0.5, d = Math.abs(topOf(idx) - L);
      if (d < 120 && topOf(idx) > 70 && topOf(idx) < innerHeight - 50) return -1; // still a fine spot
      const s = w > idx ? 1 : -1;
      let n = idx + s;
      while (n !== w && (topOf(n) < 60 || topOf(n) > innerHeight - 40)) n += s;
      return n;
    }

    function hop(to: number, now: number) {
      const a = stepAt(idx), b = stepAt(to);
      a.y = Math.min(Math.max(a.y, -H), innerHeight + H);
      const up = b.y < a.y;
      if (Math.abs(b.x - a.x) > 2) dir = b.x > a.x ? 1 : -1;
      const apex = up ? b.y - 16 : a.y - 18, h1 = a.y - apex, h2 = b.y - apex;
      const T = Math.sqrt((2 * h1) / G) + Math.sqrt((2 * h2) / G);
      jump = { to, a0: a, b0: b, T, v0: -Math.sqrt(2 * G * h1), up };
      phase = 'pre'; t0 = now;
      look(1.4, up ? -1.6 : 1.6);
      body.classList.remove('idle');
    }

    function look(x: number, y: number) { pupils.forEach((p) => (p.style.transform = `translate(${x}px, ${y}px)`)); }
    function blink(d = 150) {
      eyes.forEach((e) => e.animate([{ transform: 'scaleY(1)' }, { transform: 'scaleY(.08)', offset: 0.45 }, { transform: 'scaleY(.08)', offset: 0.55 }, { transform: 'scaleY(1)' }], { duration: d, easing: 'ease-in-out' }));
    }
    (function blinkLoop() { if (phase === 'idle') { blink(); if (Math.random() < 0.3) setTimeout(() => blink(), 230); } setTimeout(blinkLoop, 2200 + Math.random() * 2800); })();
    addEventListener('pointermove', (e) => { mx = e.clientX; my = e.clientY; }, { passive: true });
    const legPose = (a: number, b: number) => { legs[0].style.transform = `rotate(${a}deg)`; legs[1].style.transform = `rotate(${b}deg)`; };

    const PRE = 80, LAND = 260;
    function frame(now: number) {
      let x = 0, y = 0, sx = 1, sy = 1, r = 0;
      const bob = 0;
      if (idx < 0 && path.length) {
        // Start on the Contact me button once it has faded in; wait (hidden) while it is below the fold.
        const t = topOf(0);
        if (path[0].p === START && shown(START!) && t > 0 && t < innerHeight - 50) idx = 0;
        else if (path[0].p !== START || t <= 0) { const w = wanted(); if (w >= 0) idx = w; }
        if (idx >= 0) { el.hidden = false; body.classList.add('idle'); }
      } else if (idx >= 0 && phase === 'idle' && !(idx === 0 && Math.abs(scrollY - y0) < 40)) { const n = nextStep(); if (n >= 0) hop(n, now); }

      if (phase === 'pre') {
        const k = Math.sin((Math.PI / 2) * Math.min((now - t0) / PRE, 1)), p = stepAt(idx);
        x = p.x; y = Math.min(Math.max(p.y, -H), innerHeight + H); sx = 1 + 0.1 * k; sy = 1 - 0.14 * k; legPose(-12 * k, 12 * k);
        if (now - t0 >= PRE) { phase = 'air'; t0 = now; }
      } else if (phase === 'air') {
        const j = jump!, t = Math.min((now - t0) / 1000, j.T), u = t / j.T;
        const a = stepAt(idx), b = stepAt(j.to);
        a.y = Math.min(Math.max(a.y, -H), innerHeight + H);
        // Ballistic arc measured against the take-off line, laid over the live start and end points,
        // so it keeps landing on target while the page scrolls under it.
        const phys = j.v0 * t + 0.5 * G * t * t, line = (j.b0.y - j.a0.y) * u;
        x = a.x + (b.x - a.x) * u; y = a.y + (b.y - a.y) * u + (phys - line);
        const vy = j.v0 + G * t, s = Math.min(0.14, Math.abs(vy) / 8000);
        sy = 1 + s; sx = 1 - s * 0.55; r = dir * Math.max(-9, Math.min(9, vy / 120)) * 0.5 * (j.up ? -1 : 1);
        legPose(vy < 0 ? -22 : 14, vy < 0 ? 26 : -10);
        if (u >= 1) { phase = 'land'; t0 = now; idx = j.to; jump = null; blink(170); legPose(0, 0); }
      } else if (phase === 'land') {
        const k = Math.min((now - t0) / LAND, 1), d = Math.exp(-5 * k) * Math.cos(k * Math.PI * 3), p = stepAt(idx);
        x = p.x; y = p.y; sy = 1 - 0.2 * d; sx = 1 + 0.14 * d;
        if (k >= 1) { phase = 'idle'; body.classList.add('idle'); }
      } else if (phase === 'idle' && idx >= 0) {
        const p = stepAt(idx); x = p.x; y = p.y;
        if (mx >= 0) { const dx = mx - x, dy = my - (y - 30), d = Math.hypot(dx, dy) || 1; look((dx / d) * 1.5 * dir, (dy / d) * 1.5); }
      }

      x = Math.min(Math.max(x, W / 2 + 6), innerWidth - W / 2 - 6); // never half off the screen
      if (idx >= 0) {
        el.style.transform = `translate3d(${(x - W / 2).toFixed(1)}px, ${(y - H + bob).toFixed(1)}px, 0)`;
        body.style.transform = `rotate(${r.toFixed(2)}deg) scale(${sx.toFixed(3)}, ${sy.toFixed(3)})`;
        face.style.transform = `scaleX(${dir})`;
      }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
    ok.addEventListener('change', (e) => { if (!e.matches) el.hidden = true; });
  }
</script>

<style>
  .sb { position: fixed; left: 0; top: 0; z-index: 40; width: 48px; height: 44px; pointer-events: none; will-change: transform; }
  .sb[hidden] { display: none; }
  .sb-body { display: block; width: 100%; height: 100%; overflow: visible; transform-origin: 50% 100%; will-change: transform; }
  .sb-face { transform-origin: 24px 44px; transition: transform 0.18s ease; }
  .sb-eye { transform-box: fill-box; transform-origin: center; }
  .sb-pupil { transition: transform 0.22s cubic-bezier(0.3, 0.7, 0.3, 1); }
  .sb-body.idle { animation: sb-idle 2.4s ease-in-out infinite; }
  @keyframes sb-idle { 0%, 100% { transform: scale(1, 1); } 50% { transform: scale(1.02, 0.97); } }
</style>
